service firebase.storage {
  match /b/{bucket}/o {
  
    // User profile and documents
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Materials path used by useMaterials hook and posts attachments
    match /materials/{forumId}/{fileId} {
      // Anyone logged in can read the course materials files
      allow read: if request.auth != null;
      
      // Allow file upload only if authenticated
      allow create: if request.auth != null;
      
      // Allow file deletion if authenticated (since client code handles usage validation logic)
      allow delete: if request.auth != null;
    }
  }
}